{
  "manifest_version": 2,
  "name": "Text Analyzer Extension",
  "version": "1.0",
  "description": "Analyze selected text and manage profiles with settings.",

  "permissions": ["contextMenus", "storage", "activeTab", "tabs"],

  "background": {
    "scripts": ["background.js"]
  },

  "browser_action": {
    "default_popup": "menu/menu.html",
    "default_icon": "icons/icon.png"
  },

  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },

  "icons": {
    "48": "icons/icon.png"
  },

  "content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": ["content-script.js"]
  }
]

}
