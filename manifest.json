{
  "manifest_version": 2,
  "name": "ALTA Popup",
  "version": "1.0",
  "description": "Analyze selected text and manage profiles with settings.",

  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.mistral.ai/*",
    "https://api.groq.com/*"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "browser_action": {
    "default_popup": "menu/menu.html",
    "default_icon": "icons/altaIcon.png"
  },

  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/altaIcon.png",
    "32": "icons/altaIcon.png",
    "48": "icons/altaIcon.png",
    "128": "icons/altaIcon.png"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file://*/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
